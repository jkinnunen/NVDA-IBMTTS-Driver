msgstr "IBMTTS"

#: addon\globalPlugins\ibmtts.py:48
msgid "&Automatically check for updates for IBMTTS"
msgstr "Buscar automáticamente actualizaciones para IBMTTS"

#. Translators: This is the button to check for new updates of the add-on.
#: addon\globalPlugins\ibmtts.py:51
msgid "&Check for update"
msgstr "Buscar actualización"

#. Translators: This is the label for the IBMTTS folder address.
#: addon\globalPlugins\ibmtts.py:54
msgid "IBMTTS folder address"
msgstr "Dirección de carpeta de IBMTTS"

#. Translators: This is the label for the IBMTTS library name.
#: addon\globalPlugins\ibmtts.py:56
msgid "IBMTTS library name (dll)"
msgstr "Nombre de la librería de IBMTTS"

#. Translators: This is the button to explore and find for an IBMTTS library and files.
#: addon\globalPlugins\ibmtts.py:58
msgid "&Browse for  IBMTTS library..."
msgstr "&Buscar una librería de IBMTTS..."

#. Translators: This is the button to copy external IBMTTS files into synth driver Add-on.
#: addon\globalPlugins\ibmtts.py:61
msgid ""
"&Copy IBMTTS files in an  add-on (may not work for some IBMTTS distributions)"
msgstr ""
"&Copiar los archivos de IBMTTS en un complemento. (puede no funcionar para "
"algunas distribuciones de IBMTTS)"

#: addon\globalPlugins\ibmtts.py:63
msgid "&Support IBMTTS add-on"
msgstr "&Apoyar al complemento IBMTTS"

#: addon\globalPlugins\ibmtts.py:79
msgid "Select the IBMTTS library (dll)"
msgstr "Seleccionar la librería (DLL) de IBMTTS"

#. Translators: the label for the dynamic link library extension (dll) file type
#: addon\globalPlugins\ibmtts.py:81
#, python-brace-format
msgid "dynamic link library (*.{ext})"
msgstr "librerías de enlace dinámico (*.{ext})"

#. Translators: The message displayed when the IBMTTS files folder and library name have  been set.
#: addon\globalPlugins\ibmtts.py:91
msgid ""
"The IBMTTS files location has been set. If you want  to use it with a "
"portable version of NVDA, please use the \"Copy IBMTTS files into driver add-"
"on\" button"
msgstr ""
"La ubicación de los archivos de IBMTTS ha sido establecida. Si deseas usarlo "
"en una versión portable de NVDA, por favor use el botón \"Copiar los "
"archivos de IBMTTS en el complemento\""

#. Translators: The title displayed when the IBMTTS files folder and library name have been set.
#. Translators: The title  displayed when copying IBMTTS files to Add-on was successful.
#: addon\globalPlugins\ibmtts.py:93 addon\globalPlugins\ibmtts.py:150
msgid "Success"
msgstr "Correcto"

#. Translators: The message displayed in the dialog that inform you the specified library is invalid.
#: addon\globalPlugins\ibmtts.py:99
msgid ""
"The specified dll file seems to be an incorrect IBMTTS library. Would you "
"like to select another library?"
msgstr ""
"El DLL especificado parece ser una librería incorrecta de IBMTTS. ¿Te "
"gustaría seleccionar otra librería?"

#: addon\globalPlugins\ibmtts.py:100
msgid "Error loading library"
msgstr "Error al cargar la librería"

#. Translators: The message displayed when the IBMTTS files are already in the add-on folder.
#: addon\globalPlugins\ibmtts.py:110
msgid ""
"IBMTTS files are already in the add-on folder. Source and destination paths "
"are the same. No need to copy them again."
msgstr ""
"Los archivos IBMTTS ya están en la carpeta del complemento. Las rutas de "
"origen y destino son las mismas. No es necesario volver a copiarlos."

#. Translators: The title displayed when the IBMTTS files are already in the add-on folder.
#: addon\globalPlugins\ibmtts.py:112
msgid "No need to copy"
msgstr "No hay necesidad de copiar"

#: addon\globalPlugins\ibmtts.py:116
msgid ""
"Are you sure you want to copy IBMTTS files to the local NVDA IBMTTS addon? "
"It may not work in some IBMTTS distributions."
msgstr ""
"¿Estás seguro de que deseas copiar los archivos IBMTTS al directorio local "
"del complemento IBMTTS? Es posible que no funcione en algunas distribuciones "
"de IBMTTS."

#. Translators: The title of the Asking dialog displayed when trying to copy IBMTTS files.
#: addon\globalPlugins\ibmtts.py:118
msgid "Copy IBMTTS files"
msgstr "Copiando los archivos de IBMTTS"

#: addon\globalPlugins\ibmtts.py:127
msgid ""
"Unable to copy the files because the source and destination paths are the "
"same."
msgstr ""
"No se pueden copiar los archivos porque las rutas de origen y destino son "
"las mismas."

#. Translators: The title of the dialog presented while IBMTTS files  are being copied.
#: addon\globalPlugins\ibmtts.py:138
msgid "Copying files"
msgstr "Copiando archivos"

#. Translators: The message displayed while IBMTTS files are being copied.
#: addon\globalPlugins\ibmtts.py:140
msgid "Please wait while IBMTTS files  are copied into add-on."
msgstr ""
"Por favor espere mientras los archivos de IBMTTS se copian en el complemento."

#. Translators: The message displayed when copying IBMTTS files to Add-on was successful.
#: addon\globalPlugins\ibmtts.py:148
msgid ""
"Successfully copied IBMTTS files. The local copy will be used after restart "
"NVDA."
msgstr ""
"Archivos de IBMTTS copiados correctamente. La copia local será usada después "
"de reiniciar NVDA."

#. Translators: The message displayed when errors were found while trying to copy IBMTTS files to Add-on.
#: addon\globalPlugins\ibmtts.py:156
msgid "Error copying IBMTTS files"
msgstr "Error al copiar los archivos de IBMTTS"

#: addon\installTasks.py:79
msgid ""
"You may require to restart NVDA manually due to an incompatibility with "
"older versions in the update process."
msgstr ""
"Es posible que necesites reiniciar NVDA manualmente debido a una "
"incompatibilidad con versiones anteriores durante el proceso de "
"actualización."

#: addon\installTasks.py:80
msgid "Update scheduled"
msgstr "Actualización programada"

#. Translators: the message  shown if the driver can't find libraries during installation.
#: addon\installTasks.py:107
msgid ""
"The synthesizer won't be available until you set   IBMTTS files. NVDA won't "
"show this synthesizer in teh synthesizers lists because you need to set the "
"IBMTTS files location first.\n"
"\tTo do it open the NVDA settings dialog, select IBMTTS category and use the "
"\"Browse for  IBMTTS library\" button to select the IBMTTS files folder.\n"
msgstr ""
"El sintetizador no estará disponible hasta que establezcas los archivos de "
"IBMTTS. NVDA no mostrará este sintetizador en la lista de sintetizadores "
"porque necesitas establecer la ubicación de archivos del sintetizador "
"primero.\n"
"\tPara hacer esto abre el diálogo de configuraciones de NVDA, selecciona la "
"categoría IBMTTS y use el botón para seleccionar la carpeta de archivos "
"IBMTTS.\n"

#. Translators: title of message box when user is installing NVDA
#: addon\installTasks.py:112
msgid "IBMTTS driver for NVDA"
msgstr "Controlador de IBMTTS para NVDA"

#. Add-on summary, usually the user visible name of the addon.
#. Translators: Summary for this add-on to be shown on installation and add-on information.
#: buildVars.py:17
msgid "IBMTTS driver"
msgstr "Controlador de IBMTTS"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-ons manager
#: buildVars.py:20
msgid "This is the IBMTTS synthesizer driver for NVDA."
msgstr "Este es el controlador del sintetizador IBMTTS para NVDA."

