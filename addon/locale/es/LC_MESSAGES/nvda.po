#. Translators: a message dialog asking to retry or cancel when downloading a file.
#: addon\globalPlugins\_ibmttsUtils.py:169
msgid ""
"Unable to download the file. Perhaps there is no internet access or the "
"server is not responding. Do you want to try again?"
msgstr ""
"No se puede descargar el archivo. Quizás no hay acceso a Internet o el "
"servidor no responde. ¿Deseas intentarlo nuevamente?"

#. Translators: the title of a retry cancel dialog when downloading a file.
#: addon\globalPlugins\_ibmttsUtils.py:171
msgid "Error downloading"
msgstr "Error al cargar la librería"

#. Translators: a message dialog asking to retry or cancel when copying files.
#: addon\globalPlugins\_ibmttsUtils.py:208
msgid ""
"Unable to copy a file. Perhaps it is currently being used by another process "
"or you have run out of disc space on the drive you are copying to."
msgstr ""
"Imposible copiar un archivo. Quizás este está siendo usado por otro proceso "
"o no tienes suficiente espacio en la unidad a la que se están copiando los "
"archivos."

#. Translators: the title of a retry cancel dialog when copying files.
#: addon\globalPlugins\_ibmttsUtils.py:210
msgid "Error Copying"
msgstr "Error al copiar"

